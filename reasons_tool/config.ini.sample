; 이 파일을 복사해서 이름을 config.ini 로 바꾼 뒤 값을 채우세요.
; config.ini 에는 비밀번호 역할을 하는 값이 들어 있으니 GitHub 저장소 폴더 안에 두지 마세요.

[naver]
client_id = YOUR_CLIENT_ID
client_secret = YOUR_CLIENT_SECRET

[paths]
; 대시보드 저장소를 내려받은 폴더 (안에 index.html, data 폴더가 있는 곳)
repo = C:\stock\stock-dashboard

[options]
; 검색어 (쉼표로 여러 개)
queries = 특징주
; 대시보드에 보관할 일수
days_keep = 90
; 한 번 실행할 때 최근 며칠 기사까지 가져올지
fetch_days = 3
; yes 면 실행 끝에 GitHub로 자동 업로드 (git 설치와 로그인이 되어 있어야 함)
push = no
